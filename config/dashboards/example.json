{
  "name": "example",
  "size": {
    "w": 758,
    "h": 1024
  },
  "grid": {
    "cols": 12,
    "rows": 16
  },
  "dither": "gray16",
  "widgets": [
    {
      "id": "w1",
      "type": "clock",
      "pos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 3
      },
      "config": {
        "format": "HH:mm"
      }
    },
    {
      "id": "w2",
      "type": "weather",
      "pos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "config": {
        "lat": 48.137,
        "lon": 11.575,
        "days": 3
      }
    },
    {
      "id": "w3",
      "type": "iobroker",
      "pos": {
        "x": 0,
        "y": 11,
        "w": 4,
        "h": 3
      },
      "config": {
        "base_url": "http://localhost:8087",
        "state_id": "javascript.0.outdoor_temp",
        "label": "Outside",
        "unit": "°C"
      }
    },
    {
      "id": "w4",
      "type": "calendar",
      "pos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 3
      },
      "config": {
        "username": "$icloud_user",
        "password": "$icloud_app_password",
        "calendar_name": "Home",
        "max_events": 5,
        "lookahead_days": 7,
        "date_time_format": "default"
      }
    }
  ],
  "theme": {
    "preset": "editorial",
    "border_style": "thin",
    "density": "roomy"
  }
}
