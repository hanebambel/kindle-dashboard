      "config": {
        "format": "HH:mm"
      }
    },
    {
      "id": "w2",
      "type": "weather",
      "pos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "config": {
        "lat": 48.137,
        "lon": 11.575,
        "days": 3
      }
    },
    {
      "id": "w4",
      "type": "calendar",
